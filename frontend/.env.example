# Copy to .env.local and adjust when the PHP backend is ready.
# mock = data served in the browser (default, no server needed)
# live = real requests to VITE_API_BASE_URL
VITE_API_MODE=mock

# When VITE_API_MODE=live, point this at the PHP backend.
# - Production / same origin: /api
# - Local dev before a Vite proxy exists: use the full URL, e.g.
#   http://localhost:8000/api  (PHP must send CORS + credentials headers)
VITE_API_BASE_URL=/api
